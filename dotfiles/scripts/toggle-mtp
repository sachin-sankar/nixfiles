MOUNT_POINT="$HOME/phone"
mkdir -p "$MOUNT_POINT"

print_status() {
  local type="$1"
  local message="$2"
  if [ "$type" == "success" ]; then
    gum style --foreground 2 "✔ $message"
  elif [ "$type" == "info" ]; then
    gum style --foreground 4 "ℹ $message"
  elif [ "$type" == "error" ]; then
    gum style --foreground 1 --bold "✘ Error: $message"
  fi
}

if mountpoint -q "$MOUNT_POINT" || grep -q "simple-mtpfs" /proc/mounts; then
  print_status "info" "Unmounting Android device safely..."
  fusermount -u "$MOUNT_POINT"

  print_status "success" "Device safely unmounted from $MOUNT_POINT"
else
  if ! simple-mtpfs --list-devices &>/dev/null; then
    print_status "error" "No MTP devices detected."
    gum style --foreground 8 "Please ensure:"
    echo "  • Your phone is connected via USB"
    echo "  • The screen is completely unlocked"
    echo "  • USB configuration is set to 'File Transfer / MTP'"
    exit 1
  fi

  print_status "info" "Establishing MTP handshake and mounting..."
  simple-mtpfs "$MOUNT_POINT"

  if mountpoint -q "$MOUNT_POINT"; then
    print_status "success" "Android device mounted successfully!"

    gum style \
      --border normal \
      --margin "1 2" \
      --padding "1 2" \
      --border-foreground 4 \
      "Mount Directory: $MOUNT_POINT" \
      "$(gum style --foreground 8 'You can now browse your files safely via terminal or file manager.')"
  else
    print_status "error" "Mount action initialized but directory validation failed."
    exit 1
  fi
fi
